{
  "name": "@siftr/backend",
  "version": "0.1.0",
  "description": "siftr backend API and infrastructure",
  "type": "module",
  "exports": {
    "./client": {
      "types": "./src/api/index.ts",
      "default": "./src/api/index.ts"
    },
    "./schemas/*": {
      "types": "./src/api/routes/*/*.schema.ts",
      "default": "./src/api/routes/*/*.schema.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/api/index.ts",
    "dev:docker": "docker compose up",
    "build": "node esbuild.config.mjs",
    "package": "npm run build && cd dist/api && zip -r ../api.zip .",
    "test": "vitest",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.705.0",
    "@aws-sdk/client-dynamodb": "^3.705.0",
    "@aws-sdk/lib-dynamodb": "^3.705.0",
    "@hono/node-server": "^1.19.6",
    "@hono/standard-validator": "^0.1.5",
    "@scalar/hono-api-reference": "^0.9.25",
    "@smithy/node-http-handler": "^3.3.2",
    "camelcase-keys": "^10.0.1",
    "hono": "^4.10.7",
    "hono-openapi": "^1.1.1",
    "jose": "^5.9.6",
    "neverthrow": "^8.2.0",
    "snakecase-keys": "^9.0.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@aws-sdk/types": "^3.705.0",
    "@biomejs/biome": "^1.9.4",
    "@types/camelcase-keys": "^4.1.0",
    "@types/node": "^22.10.2",
    "@types/snakecase-keys": "^2.1.0",
    "esbuild": "^0.27.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.0.15"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
